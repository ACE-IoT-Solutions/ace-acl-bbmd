        {
          "expr": "sum by (job) (bacnet_packets_total{action=\"allow\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Allowed",
          "refId": "B"
        },
        {
          "expr": "sum by (job) (bacnet_packets_total{action=\"deny\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Denied",
          "refId": "C"
        }
      ],
