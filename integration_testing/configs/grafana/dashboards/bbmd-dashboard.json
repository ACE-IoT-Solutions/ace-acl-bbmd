      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": false
            },
            "indexByName": {},
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "Packets Allowed",
              "Value #C": "Packets Denied",
              "address": "Address",
              "job": "BBMD",
              "version": "Version"
